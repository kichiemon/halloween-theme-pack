<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HALLOWEEN THEME PACK // CYBERPUNK TERMINAL</title>
  <meta name="description" content="Cyberpunk Terminal theme suite for Warp, Raycast, Ghostty, Alacritty, VS Code, K9s, and 30+ developer tools. Dark void bg, neon slime & blood accents.">
  <meta name="theme-color" content="#1a0d2e">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💀</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; border-radius: 0 !important; }
    :root {
      --bg-void: #1a0d2e; --bg-darker: #10061f; --bg-surface: #241340; --bg-panel: #160a29;
      --border-dim: #3d2a5e; --border-bright: #68489e;
      --neon-slime: #39ff14; --neon-blood: #ff4d6d; --neon-pumpkin: #ff6b35;
      --neon-cyan: #5ffbf1; --neon-witch: #c77dff; --neon-yellow: #ffb347;
      --text-bone: #f4e7d3; --text-muted: #8e7eb0; --text-dim: #5c4b78;
      --glow-slime: 0 0 12px rgba(57, 255, 20, 0.45);
      --glow-blood: 0 0 12px rgba(255, 77, 109, 0.45);
      --glow-pumpkin: 0 0 14px rgba(255, 107, 53, 0.4);
    }
    html { background-color: var(--bg-void); color: var(--text-bone); font-family: 'JetBrains Mono', monospace; font-size: 14px; line-height: 1.5; scroll-behavior: smooth; }
    body { min-height: 100vh; background-color: var(--bg-void); background-image: linear-gradient(rgba(57, 255, 20, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(57, 255, 20, 0.02) 1px, transparent 1px); background-size: 32px 32px; position: relative; overflow-x: hidden; }
    .crt-scanlines { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.02), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.02)); background-size: 100% 4px, 6px 100%; z-index: 9999; }
    .crt-vignette { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; background: radial-gradient(circle at 50% 50%, transparent 65%, rgba(10, 4, 20, 0.85) 100%); z-index: 9998; }
    .container { max-width: 1080px; margin: 0 auto; padding: 24px 16px 80px; }
    .warp-header { border: 1px solid var(--border-dim); background: var(--bg-darker); display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; margin-bottom: 24px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5); }
    .warp-dots { display: flex; gap: 8px; }
    .warp-dot { width: 10px; height: 10px; }
    .warp-dot.red { background: var(--neon-blood); box-shadow: var(--glow-blood); }
    .warp-dot.yellow { background: var(--neon-yellow); }
    .warp-dot.green { background: var(--neon-slime); box-shadow: var(--glow-slime); }
    .warp-title { color: var(--neon-slime); font-size: 12px; font-weight: 700; letter-spacing: 1px; }
    .warp-badge { font-size: 11px; padding: 2px 8px; background: var(--bg-surface); border: 1px solid var(--neon-blood); color: var(--neon-blood); font-weight: 700; }
    .terminal-window { border: 1px solid var(--border-dim); background: var(--bg-panel); margin-bottom: 32px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6); position: relative; }
    .terminal-window.highlight-slime { border-color: var(--neon-slime); box-shadow: 0 0 20px rgba(57, 255, 20, 0.15); }
    .window-titlebar { background: var(--bg-darker); border-bottom: 1px solid var(--border-dim); padding: 8px 14px; display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--text-muted); }
    .window-titlebar .meta-tag { color: var(--neon-cyan); }
    .hero-body { padding: 24px 20px; }
    .ascii-hero { display: block; font-family: 'JetBrains Mono', monospace; font-size: clamp(8px, 1.35vw, 12px); line-height: 1.18; color: var(--neon-pumpkin); text-shadow: 0 0 8px rgba(255, 107, 53, 0.4); overflow-x: auto; white-space: pre; margin: 0 auto 20px; padding: 12px; background: var(--bg-darker); border: 1px dashed var(--border-dim); }
    .ascii-green { color: var(--neon-slime); text-shadow: var(--glow-slime); }
    .ascii-blood { color: var(--neon-blood); text-shadow: var(--glow-blood); }
    .ascii-cyan { color: var(--neon-cyan); }
    .ascii-bone { color: var(--text-bone); }
    .hero-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 16px; border-top: 1px solid var(--border-dim); padding-top: 16px; }
    .meta-box { background: var(--bg-darker); border: 1px solid var(--border-dim); padding: 10px 14px; }
    .meta-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }
    .meta-value { font-size: 13px; font-weight: 700; color: var(--neon-slime); margin-top: 2px; }
    .section-header { display: flex; align-items: center; gap: 12px; margin: 36px 0 16px; padding-bottom: 6px; border-bottom: 1px solid var(--border-dim); }
    .section-num { background: var(--neon-blood); color: var(--bg-darker); font-weight: 800; font-size: 12px; padding: 2px 8px; }
    .section-title { font-size: 16px; font-weight: 700; color: var(--text-bone); text-transform: uppercase; letter-spacing: 1px; }
    .section-title span { color: var(--neon-slime); }
    .prompt-block { background: var(--bg-darker); border: 1px solid var(--border-dim); padding: 16px; }
    .prompt-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; border-bottom: 1px solid var(--border-dim); padding-bottom: 12px; }
    .prompt-tab { background: var(--bg-surface); border: 1px solid var(--border-dim); color: var(--text-bone); font-family: inherit; font-size: 12px; padding: 6px 14px; cursor: pointer; transition: all 0.15s ease; }
    .prompt-tab:hover { border-color: var(--neon-slime); color: var(--neon-slime); }
    .prompt-tab.active { background: var(--neon-slime); color: var(--bg-darker); border-color: var(--neon-slime); font-weight: 700; box-shadow: var(--glow-slime); }
    .prompt-line { display: flex; align-items: center; gap: 10px; font-size: 14px; margin-bottom: 12px; }
    .prompt-symbol { color: var(--neon-blood); font-weight: 800; }
    .prompt-text { color: var(--neon-slime); font-weight: 600; }
    .cursor-blink { display: inline-block; width: 8px; height: 15px; background: var(--neon-slime); vertical-align: middle; animation: blink 1s step-end infinite; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    .prompt-output { background: #0d0417; border: 1px solid #231238; padding: 12px 14px; color: var(--text-muted); font-size: 12px; line-height: 1.6; white-space: pre-wrap; }
    .prompt-output .highlight { color: var(--neon-pumpkin); font-weight: 600; }
    .prompt-output .green { color: var(--neon-slime); }
    .prompt-output .cyan { color: var(--neon-cyan); }
    .palette-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
    .swatch-card { background: var(--bg-darker); border: 1px solid var(--border-dim); padding: 12px; cursor: pointer; transition: transform 0.1s ease, border-color 0.15s ease; }
    .swatch-card:hover { border-color: var(--neon-slime); transform: translateY(-2px); }
    .swatch-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .swatch-name { font-size: 11px; font-weight: 700; color: var(--text-bone); text-transform: uppercase; }
    .swatch-copy-hint { font-size: 9px; color: var(--neon-slime); letter-spacing: 0.5px; }
    .swatch-preview { height: 48px; width: 100%; border: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: flex-end; padding: 6px; margin-bottom: 8px; }
    .swatch-ansi { font-size: 11px; font-weight: 700; background: rgba(0, 0, 0, 0.7); padding: 1px 6px; color: #fff; }
    .swatch-meta { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); }
    .swatch-hex { font-weight: 700; color: var(--neon-cyan); }
    .copy-banner { margin-top: 12px; padding: 8px 14px; background: var(--bg-darker); border: 1px solid var(--border-dim); font-size: 11px; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center; }
    .copy-banner .active-copy { color: var(--neon-slime); font-weight: 700; }
    .variants-container { display: grid; grid-template-columns: 1fr; gap: 16px; }
    .variant-nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; }
    .variant-btn { background: var(--bg-darker); border: 1px solid var(--border-dim); padding: 10px 12px; color: var(--text-bone); font-family: inherit; text-align: left; cursor: pointer; transition: all 0.15s ease; }
    .variant-btn:hover { border-color: var(--neon-blood); }
    .variant-btn.active { border-color: var(--neon-blood); background: var(--bg-surface); box-shadow: var(--glow-blood); }
    .variant-cmd { font-size: 10px; color: var(--neon-blood); display: block; margin-bottom: 2px; }
    .variant-title { font-size: 13px; font-weight: 700; }
    .variant-terminal-view { background: var(--bg-darker); border: 1px solid var(--border-dim); padding: 18px; }
    .variant-info-bar { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; border-bottom: 1px solid var(--border-dim); padding-bottom: 10px; font-size: 11px; }
    .variant-tag { background: #2a1548; border: 1px solid var(--border-bright); padding: 2px 8px; color: var(--neon-cyan); }
    .variant-preview-swatches { display: flex; gap: 8px; margin: 14px 0; }
    .mini-swatch { flex: 1; height: 32px; border: 1px solid rgba(255, 255, 255, 0.15); display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 700; }
    .features-panel { background: var(--bg-darker); border: 1px solid var(--border-dim); padding: 18px; }
    .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; margin-top: 12px; }
    .feature-card { background: var(--bg-panel); border: 1px solid var(--border-dim); padding: 14px; position: relative; }
    .feature-card::before { content: "[OK]"; position: absolute; top: 12px; right: 12px; font-size: 10px; font-weight: 800; color: var(--neon-slime); }
    .feature-id { font-size: 10px; color: var(--neon-blood); font-weight: 700; margin-bottom: 4px; }
    .feature-name { font-size: 14px; font-weight: 700; color: var(--text-bone); margin-bottom: 6px; }
    .feature-desc { font-size: 11px; color: var(--text-muted); line-height: 1.5; }
    .tree-panel { background: var(--bg-darker); border: 1px solid var(--border-dim); padding: 16px; }
    .tree-filter-bar { display: flex; gap: 10px; margin-bottom: 12px; }
    .tree-search-input { flex: 1; background: var(--bg-panel); border: 1px solid var(--border-dim); padding: 8px 12px; color: var(--neon-slime); font-family: inherit; font-size: 12px; }
    .tree-search-input:focus { outline: none; border-color: var(--neon-slime); box-shadow: var(--glow-slime); }
    .tree-output { font-family: 'JetBrains Mono', monospace; font-size: 12px; line-height: 1.6; color: var(--text-bone); overflow-x: auto; background: #0b0313; border: 1px solid #231238; padding: 14px; max-height: 380px; overflow-y: auto; }
    .tree-dir { color: var(--neon-pumpkin); font-weight: 700; }
    .tree-file { color: var(--neon-slime); }
    .tree-comment { color: var(--text-dim); }
    .install-box { background: var(--bg-darker); border: 2px solid var(--neon-slime); box-shadow: 0 0 24px rgba(57, 255, 20, 0.2); padding: 24px; margin: 36px 0; }
    .install-label { font-size: 11px; color: var(--neon-slime); font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
    .install-cmd-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .install-input { flex: 1; min-width: 260px; background: #090212; border: 1px solid var(--border-bright); color: var(--neon-slime); font-family: inherit; font-size: 13px; padding: 12px 14px; font-weight: 600; }
    .btn-sharp { background: var(--neon-slime); color: var(--bg-darker); border: none; font-family: inherit; font-size: 12px; font-weight: 800; padding: 12px 20px; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; box-shadow: var(--glow-slime); transition: all 0.15s ease; white-space: nowrap; }
    .btn-sharp:hover { background: #fff; color: #000; }
    .install-secondary { margin-top: 16px; display: flex; align-items: center; gap: 10px; font-size: 11px; color: var(--text-muted); }
    .install-secondary code { background: var(--bg-surface); color: var(--neon-pumpkin); padding: 4px 8px; border: 1px solid var(--border-dim); }
    .terminal-footer { border-top: 1px solid var(--border-dim); padding-top: 24px; margin-top: 48px; }
    .status-line { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 11px; color: var(--text-muted); margin-bottom: 16px; background: var(--bg-darker); border: 1px solid var(--border-dim); padding: 8px 14px; }
    .status-left { display: flex; gap: 14px; }
    .status-active { color: var(--neon-slime); font-weight: 700; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 12px; }
    .footer-link { background: var(--bg-darker); border: 1px solid var(--border-dim); color: var(--text-bone); padding: 8px 14px; text-decoration: none; font-size: 11px; font-weight: 600; transition: all 0.15s ease; }
    .footer-link:hover { border-color: var(--neon-blood); color: var(--neon-blood); box-shadow: var(--glow-blood); }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
      .cursor-blink { animation: none !important; opacity: 1 !important; }
      .swatch-card:hover { transform: none !important; }
    }
    @media (max-width: 640px) {
      .container { padding: 12px 10px 48px; }
      .warp-header { flex-direction: column; align-items: flex-start; gap: 8px; }
      .hero-body { padding: 14px 10px; }
      .install-cmd-row { flex-direction: column; }
      .btn-sharp { width: 100%; text-align: center; }
    }
  </style>
</head>
<body>
  <div class="crt-scanlines" aria-hidden="true"></div>
  <div class="crt-vignette" aria-hidden="true"></div>
  <div class="container">
    <header class="warp-header">
      <div class="warp-dots" aria-hidden="true">
        <span class="warp-dot red"></span><span class="warp-dot yellow"></span><span class="warp-dot green"></span>
      </div>
      <div class="warp-title">term://halloween-theme-pack/core.sh &mdash; [PORT: 1031]</div>
      <div class="warp-badge">CYBERPUNK v2.4.0</div>
    </header>

    <!-- SECTION 1: ASCII ART HERO -->
    <section class="terminal-window highlight-slime" id="hero">
      <div class="window-titlebar">
        <span>SESSION: 0xDEADBEEF // WARP_RAYCAST_SUBSYSTEM</span>
        <span class="meta-tag">SYS_STATUS: ARMED [WCAG AAA]</span>
      </div>
      <div class="hero-body">
<pre class="ascii-hero" aria-label="ASCII art of Halloween cyber skull and pumpkin">
<span class="ascii-blood">                 __..._   _...__</span>
<span class="ascii-blood">               .'      `"`      '.</span>
<span class="ascii-pumpkin">              /  __...--'--...__  \</span>
<span class="ascii-pumpkin">             | .'  .-.     .-.  '. |</span>     <span class="ascii-green"> _   _    _    _     _     _____ _      __ _____ _____ _   _ </span>
<span class="ascii-pumpkin">             | |  (</span><span class="ascii-bone"> o </span><span class="ascii-pumpkin">)   (</span><span class="ascii-bone"> o </span><span class="ascii-pumpkin">)  | |</span>    <span class="ascii-green">| | | |  / \  | |   | |   | ____| \    / /| ____| ____| \ | |</span>
<span class="ascii-blood">            /  '._ '-' ___ '-' _.'  \</span>   <span class="ascii-green">| |_| | / _ \ | |   | |   |  _|  \ \  / / |  _| |  _| | \| |</span>
<span class="ascii-blood">           |      `---'   '---`      |</span>  <span class="ascii-cyan">|  _  |/ ___ \| |___| |___| |___   \ \/ /  | |___| |___| |\  |</span>
<span class="ascii-bone">           |    \_______________/    |</span>  <span class="ascii-cyan">|_| |_/_/   \_\_____|_____|_____|   \_/   |_____|_____|_| \_|</span>
<span class="ascii-bone">            \    \  | | | | |  /    /</span>   <span class="ascii-pumpkin">&gt;&gt;&gt; 200+ HACKER-GRADE THEMES // WARP &amp; RAYCAST SPEC &lt;&lt;&lt;</span>
<span class="ascii-blood">             '.   '-'-'-'-'-'   .'</span>      <span class="ascii-green">[STATUS: ONLINE]</span> <span class="ascii-blood">[SLIME &amp; BLOOD]</span> <span class="ascii-cyan">[DARK VOID: #1A0D2E]</span>
<span class="ascii-blood">               `'-.._______..-'`</span>
</pre>
        <div class="hero-meta">
          <div class="meta-box"><div class="meta-label">TARGET PLATFORMS</div><div class="meta-value">30+ TERMINALS &amp; TUIS</div></div>
          <div class="meta-box"><div class="meta-label">MAX CONTRAST RATIO</div><div class="meta-value">15.09:1 (WCAG AAA)</div></div>
          <div class="meta-box"><div class="meta-label">VARIANTS COMPILED</div><div class="meta-value">5 MATRIX PROFILES</div></div>
          <div class="meta-box"><div class="meta-label">BINARY FOOTPRINT</div><div class="meta-value">ZERO RUNTIME DEPENDENCIES</div></div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: TERMINAL PROMPT WITH USAGE -->
    <section id="usage">
      <div class="section-header">
        <span class="section-num">02</span>
        <h2 class="section-title">TERMINAL PROMPT <span>// USAGE PROTOCOLS</span></h2>
      </div>
      <div class="prompt-block">
        <div class="prompt-tabs" role="tablist">
          <button class="prompt-tab active" onclick="switchPrompt('apply')" role="tab" id="tab-apply">halloween apply</button>
          <button class="prompt-tab" onclick="switchPrompt('install')" role="tab" id="tab-install">halloween install</button>
          <button class="prompt-tab" onclick="switchPrompt('preview')" role="tab" id="tab-preview">halloween preview</button>
          <button class="prompt-tab" onclick="switchPrompt('export')" role="tab" id="tab-export">halloween-gen --out</button>
        </div>
        <div class="prompt-line">
          <span class="prompt-symbol">root@station:~$</span>
          <span class="prompt-text" id="prompt-command-text">./bin/halloween-gen apply --variant dark</span>
          <span class="cursor-blink" aria-hidden="true"></span>
        </div>
        <pre class="prompt-output" id="prompt-output-box"><span class="green">[+] Auto-detecting installed environments...</span>
[✓] Found Ghostty config at ~/.config/ghostty/themes/
[✓] Found Alacritty config at ~/.config/alacritty/alacritty.toml
[✓] Found Kitty config at ~/.config/kitty/kitty.conf
[✓] Found K9s skin folder at ~/.config/k9s/skins/
[✓] Found VS Code extension store at ~/.vscode/extensions/
<span class="highlight">[+] Injected 'Halloween (Night / Dark)' profile into 5 active targets.</span>
<span class="cyan">&gt;&gt; RELOAD SIGNALS SENT. TERMINAL MATRIX ARMED. (0.012s)</span></pre>
      </div>
    </section>

    <!-- SECTION 3: CORE PALETTE SWATCHES -->
    <section id="palette">
      <div class="section-header">
        <span class="section-num">03</span>
        <h2 class="section-title">CORE PALETTE SWATCHES <span>// CLICK-TO-COPY</span></h2>
      </div>
      <div class="palette-grid">
        <div class="swatch-card" onclick="copyHex('#1a0d2e', 'DARK VOID BASE')">
          <div class="swatch-header"><span class="swatch-name">Dark Void (Bg)</span><span class="swatch-copy-hint">[COPY]</span></div>
          <div class="swatch-preview" style="background-color: #1a0d2e;"><span class="swatch-ansi">ANSI: BG_BASE</span></div>
          <div class="swatch-meta"><span>HEX</span><span class="swatch-hex">#1a0d2e</span></div>
        </div>
        <div class="swatch-card" onclick="copyHex('#39ff14', 'SLIME GREEN')">
          <div class="swatch-header"><span class="swatch-name">Slime Neon</span><span class="swatch-copy-hint">[COPY]</span></div>
          <div class="swatch-preview" style="background-color: #39ff14;"><span class="swatch-ansi" style="color:#000; background:#fff;">ANSI: GREEN</span></div>
          <div class="swatch-meta"><span>HEX</span><span class="swatch-hex" style="color:var(--neon-slime);">#39ff14</span></div>
        </div>
        <div class="swatch-card" onclick="copyHex('#ff4d6d', 'BLOOD RED')">
          <div class="swatch-header"><span class="swatch-name">Blood Red</span><span class="swatch-copy-hint">[COPY]</span></div>
          <div class="swatch-preview" style="background-color: #ff4d6d;"><span class="swatch-ansi">ANSI: RED</span></div>
          <div class="swatch-meta"><span>HEX</span><span class="swatch-hex" style="color:var(--neon-blood);">#ff4d6d</span></div>
        </div>
        <div class="swatch-card" onclick="copyHex('#ff6b35', 'PUMPKIN ORANGE')">
          <div class="swatch-header"><span class="swatch-name">Neon Pumpkin</span><span class="swatch-copy-hint">[COPY]</span></div>
          <div class="swatch-preview" style="background-color: #ff6b35;"><span class="swatch-ansi">ANSI: ACCENT</span></div>
          <div class="swatch-meta"><span>HEX</span><span class="swatch-hex" style="color:var(--neon-pumpkin);">#ff6b35</span></div>
        </div>
        <div class="swatch-card" onclick="copyHex('#5ffbf1', 'PLASMA CYAN')">
          <div class="swatch-header"><span class="swatch-name">Laser Cyan</span><span class="swatch-copy-hint">[COPY]</span></div>
          <div class="swatch-preview" style="background-color: #5ffbf1;"><span class="swatch-ansi" style="color:#000; background:#fff;">ANSI: CYAN</span></div>
          <div class="swatch-meta"><span>HEX</span><span class="swatch-hex" style="color:var(--neon-cyan);">#5ffbf1</span></div>
        </div>
        <div class="swatch-card" onclick="copyHex('#c77dff', 'WITCH VIOLET')">
          <div class="swatch-header"><span class="swatch-name">Witch Magenta</span><span class="swatch-copy-hint">[COPY]</span></div>
          <div class="swatch-preview" style="background-color: #c77dff;"><span class="swatch-ansi">ANSI: MAGENTA</span></div>
          <div class="swatch-meta"><span>HEX</span><span class="swatch-hex" style="color:var(--neon-witch);">#c77dff</span></div>
        </div>
        <div class="swatch-card" onclick="copyHex('#f4e7d3', 'BONE WHITE')">
          <div class="swatch-header"><span class="swatch-name">Bone Text</span><span class="swatch-copy-hint">[COPY]</span></div>
          <div class="swatch-preview" style="background-color: #f4e7d3;"><span class="swatch-ansi" style="color:#000; background:#fff;">ANSI: FG_WHITE</span></div>
          <div class="swatch-meta"><span>HEX</span><span class="swatch-hex">#f4e7d3</span></div>
        </div>
        <div class="swatch-card" onclick="copyHex('#2d1b4e', 'SHADOW PURPLE')">
          <div class="swatch-header"><span class="swatch-name">Shadow Surface</span><span class="swatch-copy-hint">[COPY]</span></div>
          <div class="swatch-preview" style="background-color: #2d1b4e;"><span class="swatch-ansi">ANSI: BLACK</span></div>
          <div class="swatch-meta"><span>HEX</span><span class="swatch-hex">#2d1b4e</span></div>
        </div>
      </div>
      <div class="copy-banner" id="copy-banner">
        <span>CLIPBOARD BUFFER:</span>
        <span class="active-copy" id="copy-status">[ CLICK ANY SWATCH TO COPY HEX ]</span>
      </div>
    </section>

    <!-- SECTION 4: 5 VARIANTS AS TERMINAL COMMANDS -->
    <section id="variants">
      <div class="section-header">
        <span class="section-num">04</span>
        <h2 class="section-title">5 MATRIX VARIANTS <span>// TERMINAL COMMAND SELECTOR</span></h2>
      </div>
      <div class="variants-container">
        <div class="variant-nav">
          <button class="variant-btn active" onclick="selectVariant(0)" id="vbtn-0">
            <span class="variant-cmd">$ halloween --variant dark</span><span class="variant-title">01. NIGHT (DARK)</span>
          </button>
          <button class="variant-btn" onclick="selectVariant(1)" id="vbtn-1">
            <span class="variant-cmd">$ halloween --variant light</span><span class="variant-title">02. DAY (LIGHT)</span>
          </button>
          <button class="variant-btn" onclick="selectVariant(2)" id="vbtn-2">
            <span class="variant-cmd">$ halloween --variant oled</span><span class="variant-title">03. OLED (VOID)</span>
          </button>
          <button class="variant-btn" onclick="selectVariant(3)" id="vbtn-3">
            <span class="variant-cmd">$ halloween --variant pastel</span><span class="variant-title">04. PASTEL (KAWAII)</span>
          </button>
          <button class="variant-btn" onclick="selectVariant(4)" id="vbtn-4">
            <span class="variant-cmd">$ halloween --variant cyberpunk</span><span class="variant-title">05. CYBERPUNK (PLASMA)</span>
          </button>
        </div>
        <div class="variant-terminal-view" id="variant-display">
          <div class="variant-info-bar">
            <div><strong id="var-name" style="color: var(--neon-slime);">1. HALLOWEEN NIGHT (CORE DARK)</strong></div>
            <div class="variant-tag" id="var-contrast">CONTRAST: 15.09:1 (WCAG AAA)</div>
            <div class="variant-tag" id="var-bg">BASE_BG: #1a0d2e</div>
          </div>
          <p id="var-desc" style="color: var(--text-bone); font-size: 13px; margin-bottom: 12px;">
            High-contrast deep purple night with neon pumpkin orange (#ff6b35), slime green (#39ff14), and blood red (#ff4d6d). Default developer profile.
          </p>
          <div class="variant-preview-swatches" id="var-swatches">
            <div class="mini-swatch" style="background:#1a0d2e; color:#fff;">#1a0d2e</div>
            <div class="mini-swatch" style="background:#ff6b35; color:#000;">#ff6b35</div>
            <div class="mini-swatch" style="background:#39ff14; color:#000;">#39ff14</div>
            <div class="mini-swatch" style="background:#ff4d6d; color:#000;">#ff4d6d</div>
            <div class="mini-swatch" style="background:#f4e7d3; color:#000;">#f4e7d3</div>
          </div>
          <div class="prompt-line" style="margin-top: 14px; margin-bottom: 0;">
            <span class="prompt-symbol">exec:</span>
            <span class="prompt-text" id="var-command">./bin/halloween-gen apply --variant dark</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: FEATURES AS TERMINAL OUTPUT -->
    <section id="features">
      <div class="section-header">
        <span class="section-num">05</span>
        <h2 class="section-title">SYSTEM FEATURES <span>// DIAGNOSTIC DUMP</span></h2>
      </div>
      <div class="features-panel">
        <div style="font-size: 11px; color: var(--neon-cyan); border-bottom: 1px solid var(--border-dim); padding-bottom: 6px;">
          $ sysctl -a | grep -E "THEME_PACK|WCAG|INSTALLER"
        </div>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-id">FEATURE // 01</div><div class="feature-name">WCAG AAA / AA Tested</div>
            <div class="feature-desc">15.09:1 text contrast ratio on primary dark surfaces, 15.73:1 on light mode. Full colorblind validation for Deuteranopia &amp; Protanopia.</div>
          </div>
          <div class="feature-card">
            <div class="feature-id">FEATURE // 02</div><div class="feature-name">30+ Target Applications</div>
            <div class="feature-desc">Terminals (Ghostty, Alacritty, Warp, Kitty), Editors (VS Code, Xcode, Obsidian), TUIs (K9s, Yazi, btop++), and shell prompts (Starship, Fish).</div>
          </div>
          <div class="feature-card">
            <div class="feature-id">FEATURE // 03</div><div class="feature-name">Standalone Binary Generator</div>
            <div class="feature-desc">Self-contained zero-dependency compiled binary (<code>bin/halloween-gen</code>). Generates 200+ theme configurations in under 15ms.</div>
          </div>
          <div class="feature-card">
            <div class="feature-id">FEATURE // 04</div><div class="feature-name">Interactive TUI Installer</div>
            <div class="feature-desc">Run <code>halloween-gen install</code> to inspect active configs, select variants, and inject themes with dry-run verification mode.</div>
          </div>
          <div class="feature-card">
            <div class="feature-id">FEATURE // 05</div><div class="feature-name">Warp &amp; Raycast Native</div>
            <div class="feature-desc">Includes Raycast theme definitions (<code>halloween.raycast.json</code>) and Warp YAML specifications tailored for modern command runners.</div>
          </div>
          <div class="feature-card">
            <div class="feature-id">FEATURE // 06</div><div class="feature-name">Strict CI Matrix Checks</div>
            <div class="feature-desc">Automated GitHub Actions validate strict hex formatting, color name uniqueness, and structure syntax across JSON, TOML, YAML &amp; XML.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 6: SUPPORTED APPS TREE OUTPUT -->
    <section id="supported-apps">
      <div class="section-header">
        <span class="section-num">06</span>
        <h2 class="section-title">SUPPORTED APPS <span>// TREE &amp; LS VIEW</span></h2>
      </div>
      <div class="tree-panel">
        <div class="tree-filter-bar">
          <input type="text" class="tree-search-input" id="treeSearch" placeholder="Type to filter apps (e.g. ghostty, k9s, vscode, starship)..." oninput="filterTree()">
        </div>
        <pre class="tree-output" id="treeContainer"><span class="tree-dir">themes/</span>
├── <span class="tree-dir">terminals/</span>
│   ├── <span class="tree-file">ghostty.config</span>         <span class="tree-comment"># Ghostty native theme</span>
│   ├── <span class="tree-file">alacritty.toml</span>         <span class="tree-comment"># Alacritty v0.13+ TOML</span>
│   ├── <span class="tree-file">kitty.conf</span>             <span class="tree-comment"># Kitty terminal colors</span>
│   ├── <span class="tree-file">wezterm.lua</span>            <span class="tree-comment"># WezTerm Lua color table</span>
│   ├── <span class="tree-file">iterm2.itermcolors</span>     <span class="tree-comment"># iTerm2 XML color preset</span>
│   ├── <span class="tree-file">warp.yaml</span>              <span class="tree-comment"># Warp Terminal YAML</span>
│   ├── <span class="tree-file">windows-terminal.json</span>  <span class="tree-comment"># Windows Terminal scheme</span>
│   ├── <span class="tree-file">hyper.js</span>               <span class="tree-comment"># Hyper.js plugin</span>
│   ├── <span class="tree-file">tabby.yaml</span>             <span class="tree-comment"># Tabby terminal</span>
│   ├── <span class="tree-file">rio.toml</span>               <span class="tree-comment"># Rio terminal</span>
│   ├── <span class="tree-file">tmux.conf</span>              <span class="tree-comment"># tmux statusline &amp; panes</span>
│   └── <span class="tree-file">apple-terminal.terminal</span><span class="tree-comment"># Apple Terminal.app</span>
├── <span class="tree-dir">editors/</span>
│   ├── <span class="tree-file">vscode-theme.json</span>      <span class="tree-comment"># Visual Studio Code</span>
│   ├── <span class="tree-file">obsidian-theme.css</span>     <span class="tree-comment"># Obsidian vault theme</span>
│   ├── <span class="tree-file">xcode.xccolortheme</span>     <span class="tree-comment"># Apple Xcode IDE</span>
│   └── <span class="tree-file">neovim.lua</span>             <span class="tree-comment"># Neovim / Vim lua</span>
├── <span class="tree-dir">devops_tui/</span>
│   ├── <span class="tree-file">k9s-skin.yaml</span>          <span class="tree-comment"># Kubernetes TUI</span>
│   ├── <span class="tree-file">yazi-theme.toml</span>        <span class="tree-comment"># Yazi Rust terminal file manager</span>
│   ├── <span class="tree-file">lazydocker.yaml</span>        <span class="tree-comment"># Lazydocker skin</span>
│   ├── <span class="tree-file">btop.theme</span>             <span class="tree-comment"># btop++ system monitor</span>
│   ├── <span class="tree-file">gitui.ron</span>              <span class="tree-comment"># GitUI client</span>
│   ├── <span class="tree-file">tigrc</span>                  <span class="tree-comment"># tig git browser</span>
│   ├── <span class="tree-file">glamour.json</span>           <span class="tree-comment"># Glow / Glamour markdown</span>
│   └── <span class="tree-file">pywal.json</span>             <span class="tree-comment"># Pywal colors cache</span>
├── <span class="tree-dir">shells_prompts/</span>
│   ├── <span class="tree-file">starship.toml</span>          <span class="tree-comment"># Starship cross-shell prompt</span>
│   ├── <span class="tree-file">fish_colors.fish</span>       <span class="tree-comment"># Fish shell palette</span>
│   ├── <span class="tree-file">oh-my-posh.json</span>        <span class="tree-comment"># Oh My Posh shell</span>
│   ├── <span class="tree-file">zsh-theme.zsh</span>          <span class="tree-comment"># Zsh syntax highlighting</span>
│   └── <span class="tree-file">chrome-theme.json</span>       <span class="tree-comment"># Chromium unpacked theme</span>
└── <span class="tree-dir">messaging_design/</span>
    ├── <span class="tree-file">raycast.json</span>           <span class="tree-comment"># Raycast theme import</span>
    ├── <span class="tree-file">tokens-studio.json</span>     <span class="tree-comment"># Figma / Design Tokens</span>
    ├── <span class="tree-file">slack.txt</span>              <span class="tree-comment"># Slack sidebar hex string</span>
    └── <span class="tree-file">discord.css</span>            <span class="tree-comment"># BetterDiscord theme</span></pre>
      </div>
    </section>

    <!-- SECTION 7: INSTALL COMMAND WITH COPY BUTTON -->
    <section id="install">
      <div class="section-header">
        <span class="section-num">07</span>
        <h2 class="section-title">INSTALLATION PROTOCOL <span>// ONE-LINE INGEST</span></h2>
      </div>
      <div class="install-box">
        <div class="install-label">
          <span>[TERMINAL_COMMAND]</span><span>&bull;</span><span>EXECUTE IN BASH / ZSH</span>
        </div>
        <div class="install-cmd-row">
          <input type="text" readonly class="install-input" id="installCmd" value="curl -fsSL https://raw.githubusercontent.com/kichiemon/halloween-theme-pack/main/install.sh | bash">
          <button class="btn-sharp" onclick="copyInstall()" id="copyInstallBtn">[ COPY COMMAND ]</button>
        </div>
        <div class="install-secondary">
          <span>Or run local installer binary:</span>
          <code>./bin/halloween-gen apply</code>
          <span>&bull;</span>
          <code>./bin/halloween-gen install</code>
        </div>
      </div>
    </section>

    <!-- SECTION 8: FOOTER WITH LINKS -->
    <footer class="terminal-footer">
      <div class="status-line">
        <div class="status-left">
          <span>STATUS: <span class="status-active">READY (0 ERR)</span></span>
          <span>TERM: xterm-256color</span>
          <span>LOC: void://0x1a0d2e</span>
        </div>
        <div><span>LICENSE: MIT // 2026</span></div>
      </div>
      <div class="footer-links">
        <a href="https://github.com/kichiemon/halloween-theme-pack" class="footer-link" target="_blank" rel="noopener">[  GITHUB REPO ]</a>
        <a href="https://github.com/kichiemon/halloween-theme-pack/releases" class="footer-link" target="_blank" rel="noopener">[ 📦 RELEASES ]</a>
        <a href="preview/index.html" class="footer-link">[ 🎛️ STUDIO PREVIEW ]</a>
        <a href="https://github.com/kichiemon/halloween-theme-pack/issues" class="footer-link" target="_blank" rel="noopener">[ 🐛 REPORT ISSUE ]</a>
        <a href="#hero" class="footer-link" style="margin-left: auto;">[ ↑ TOP ]</a>
      </div>
    </footer>
  </div>

  <script>
    const promptData = {
      apply: {
        cmd: './bin/halloween-gen apply --variant dark',
        output: '<span class="green">[+] Auto-detecting installed environments...</span>\n' +
                '[✓] Found Ghostty config at ~/.config/ghostty/themes/\n' +
                '[✓] Found Alacritty config at ~/.config/alacritty/alacritty.toml\n' +
                '[✓] Found Kitty config at ~/.config/kitty/kitty.conf\n' +
                '[✓] Found K9s skin folder at ~/.config/k9s/skins/\n' +
                '[✓] Found VS Code extension store at ~/.vscode/extensions/\n' +
                '<span class="highlight">[+] Injected \'Halloween (Night / Dark)\' profile into 5 active targets.</span>\n' +
                '<span class="cyan">&gt;&gt; RELOAD SIGNALS SENT. TERMINAL MATRIX ARMED. (0.012s)</span>'
      },
      install: {
        cmd: './bin/halloween-gen install',
        output: '<span class="cyan">? Which theme variant do you want?</span>\n' +
                '  &gt; [1] dark      (Night - deep purple &amp; pumpkin)\n' +
                '    [2] light     (Day - warm cream &amp; witch green)\n' +
                '    [3] oled      (Pure Void - pitch black)\n' +
                '    [4] pastel    (Kawaii - lavender mist)\n' +
                '    [5] cyberpunk (Synthwave plasma &amp; laser)\n' +
                '<span class="green">[✓] Scanning system paths... found 12 candidate applications.</span>\n' +
                '<span class="highlight">Select apps to install [comma-separated numbers or \'all\']: all</span>\n' +
                '<span class="green">✔ Installed 12 theme files. Backup copies stored safely.</span>'
      },
      preview: {
        cmd: 'open preview/index.html',
        output: '<span class="green">[+] Launching Halloween Interactive Studio...</span>\n' +
                '[✓] Loading Web Audio CRT hum oscillator (optional)\n' +
                '[✓] Initializing real-time WCAG contrast engine\n' +
                '[✓] Colorblind vision simulator mounted\n' +
                '<span class="highlight">&gt;&gt; STUDIO RUNNING AT file:///.../preview/index.html</span>\n' +
                '<span class="cyan">Enjoy zero-dependency hex tweaking and export!</span>'
      },
      export: {
        cmd: './bin/halloween-gen --out ./custom-themes/',
        output: '<span class="green">[+] Generating all target formats from halloween.yaml...</span>\n' +
                '  [YAML]  Warp, K9s, Tabby, Base16\n' +
                '  [TOML]  Alacritty, Rio, Yazi, Starship\n' +
                '  [JSON]  Windows Terminal, Raycast, Chrome, Glamour\n' +
                '  [CONF]  Kitty, tmux, btop\n' +
                '  [CSS]   Obsidian, Discord\n' +
                '  [LUA]   WezTerm, Neovim\n' +
                '<span class="highlight">[✓] 200+ theme artifacts written to ./custom-themes/ in 14.8ms.</span>'
      }
    };

    function switchPrompt(key) {
      document.querySelectorAll('.prompt-tab').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById('tab-' + key);
      if (activeBtn) activeBtn.classList.add('active');
      const data = promptData[key];
      if (data) {
        document.getElementById('prompt-command-text').textContent = data.cmd;
        document.getElementById('prompt-output-box').innerHTML = data.output;
      }
    }

    function copyHex(hex, name) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(hex).then(() => {
          showCopyStatus(`[ COPIED ${hex} (${name}) TO CLIPBOARD ]`);
        }).catch(() => fallbackCopy(hex, name));
      } else {
        fallbackCopy(hex, name);
      }
    }

    function fallbackCopy(hex, name) {
      const ta = document.createElement('textarea');
      ta.value = hex;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showCopyStatus(`[ COPIED ${hex} (${name}) TO CLIPBOARD ]`);
    }

    function showCopyStatus(msg) {
      const el = document.getElementById('copy-status');
      el.textContent = msg;
      el.style.color = 'var(--neon-slime)';
      setTimeout(() => {
        el.textContent = '[ CLICK ANY SWATCH TO COPY HEX ]';
        el.style.color = '';
      }, 3000);
    }

    const variants = [
      {
        name: "1. HALLOWEEN NIGHT (CORE DARK)",
        contrast: "CONTRAST: 15.09:1 (WCAG AAA)",
        bg: "BASE_BG: #1a0d2e",
        desc: "High-contrast deep purple night with neon pumpkin orange (#ff6b35), slime green (#39ff14), and blood red (#ff4d6d). Default developer profile.",
        cmd: "./bin/halloween-gen apply --variant dark",
        colors: ["#1a0d2e", "#ff6b35", "#39ff14", "#ff4d6d", "#f4e7d3"]
      },
      {
        name: "2. HALLOWEEN DAY (WARM LIGHT)",
        contrast: "CONTRAST: 15.73:1 (WCAG AAA)",
        bg: "BASE_BG: #faf4eb",
        desc: "Warm cream parchment background with deep purple typography (#241432), rich pumpkin (#bf4904), and forest witch green (#1b772d). Fully WCAG AA+.",
        cmd: "./bin/halloween-gen apply --variant light",
        colors: ["#faf4eb", "#241432", "#bf4904", "#1b772d", "#b81438"]
      },
      {
        name: "3. HALLOWEEN OLED (PURE VOID)",
        contrast: "CONTRAST: 21.00:1 (INFINITE)",
        bg: "BASE_BG: #000000",
        desc: "True #000000 pitch-black darkness tuned specifically for OLED displays and Apple Liquid Retina XDR screens. Zero battery drain on dark pixels.",
        cmd: "./bin/halloween-gen apply --variant oled",
        colors: ["#000000", "#ff6b35", "#39ff14", "#5ffbf1", "#f4e7d3"]
      },
      {
        name: "4. HALLOWEEN PASTEL (SPOOKY KAWAII)",
        contrast: "CONTRAST: 12.80:1 (WCAG AAA)",
        bg: "BASE_BG: #faf5fc",
        desc: "Soft lavender mist (#faf5fc) paired with deep plum lettering (#3c2a4d) and sweet pastel candy accents. Spooky aesthetic with light mood.",
        cmd: "./bin/halloween-gen apply --variant pastel",
        colors: ["#faf5fc", "#3c2a4d", "#f78c6c", "#70c1b3", "#b388ff"]
      },
      {
        name: "5. HALLOWEEN CYBERPUNK (SYNTHWAVE PLASMA)",
        contrast: "CONTRAST: 16.42:1 (WCAG AAA)",
        bg: "BASE_BG: #0d0221",
        desc: "Deep synthwave plasma void (#0d0221) fused with hyper-saturated laser slime cyan (#00f5d4), plasma red (#ff0054), and electric pumpkin.",
        cmd: "./bin/halloween-gen apply --variant cyberpunk",
        colors: ["#0d0221", "#ff6d00", "#00f5d4", "#ff0054", "#e0aaff"]
      }
    ];

    function selectVariant(idx) {
      document.querySelectorAll('.variant-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById('vbtn-' + idx);
      if (activeBtn) activeBtn.classList.add('active');

      const v = variants[idx];
      document.getElementById('var-name').textContent = v.name;
      document.getElementById('var-contrast').textContent = v.contrast;
      document.getElementById('var-bg').textContent = v.bg;
      document.getElementById('var-desc').textContent = v.desc;
      document.getElementById('var-command').textContent = v.cmd;

      const swatchContainer = document.getElementById('var-swatches');
      swatchContainer.innerHTML = '';
      v.colors.forEach(hex => {
        const d = document.createElement('div');
        d.className = 'mini-swatch';
        d.style.backgroundColor = hex;
        d.textContent = hex;
        d.style.color = (hex === '#faf4eb' || hex === '#faf5fc' || hex === '#f4e7d3' || hex === '#39ff14' || hex === '#00f5d4') ? '#000' : '#fff';
        swatchContainer.appendChild(d);
      });
    }

    const originalTreeContent = document.getElementById('treeContainer').innerHTML;

    function filterTree() {
      const q = document.getElementById('treeSearch').value.toLowerCase().trim();
      if (!q) {
        document.getElementById('treeContainer').innerHTML = originalTreeContent;
        return;
      }
      const lines = originalTreeContent.split('\n');
      const filtered = lines.filter(line => {
        const text = line.replace(/<[^>]*>/g, '').toLowerCase();
        return text.includes(q) || line.includes('themes/') || line.includes('├──') || line.includes('└──');
      });
      document.getElementById('treeContainer').innerHTML = filtered.join('\n');
    }

    function copyInstall() {
      const input = document.getElementById('installCmd');
      const btn = document.getElementById('copyInstallBtn');
      if (navigator.clipboard) {
        navigator.clipboard.writeText(input.value).then(() => {
          btn.textContent = '[ ✓ COPIED! ]';
          btn.style.background = '#fff';
          btn.style.color = '#000';
          setTimeout(() => {
            btn.textContent = '[ COPY COMMAND ]';
            btn.style.background = 'var(--neon-slime)';
            btn.style.color = 'var(--bg-darker)';
          }, 2500);
        });
      } else {
        input.select();
        document.execCommand('copy');
        btn.textContent = '[ ✓ COPIED! ]';
        setTimeout(() => {
          btn.textContent = '[ COPY COMMAND ]';
        }, 2500);
      }
    }
  </script>
</body>
</html>
