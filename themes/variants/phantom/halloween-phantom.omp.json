{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "palette": {
    "background": "#0e1626",
    "foreground": "#e6edf5",
    "accent": "#2ef8a0",
    "success": "#48f78b",
    "destructive": "#ff5277",
    "secondary": "#1c2b45",
    "card": "#152033",
    "muted": "#8fa2b8",
    "blue": "#64b5f6",
    "magenta": "#cf8eff",
    "cyan": "#2ef8a0",
    "yellow": "#ffd166"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:background",
          "background": "p:accent",
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:background",
          "background": "p:success",
          "properties": {
            "branch_icon": "\ue0a0 "
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "properties": {
            "text": " \u276f"
          }
        }
      ]
    }
  ]
}
