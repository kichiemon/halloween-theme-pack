{
  "name": "Halloween",
  "type": "dark",
  "colors": {
    "editor.background": "#1a0d2e",
    "editor.foreground": "#f4e7d3",
    "editorCursor.foreground": "#ff6b35",
    "editor.selectionBackground": "#3d2a5e",
    "editorLineNumber.foreground": "#b8a9d9",
    "editorLineNumber.activeForeground": "#ff6b35",
    "activityBar.background": "#150a24",
    "activityBar.foreground": "#f4e7d3",
    "activityBar.activeBorder": "#ff6b35",
    "sideBar.background": "#150a24",
    "sideBar.foreground": "#f4e7d3",
    "sideBarTitle.foreground": "#ff6b35",
    "statusBar.background": "#2d1b4e",
    "statusBar.foreground": "#f4e7d3",
    "titleBar.activeBackground": "#1a0d2e",
    "titleBar.activeForeground": "#f4e7d3",
    "panel.background": "#1a0d2e",
    "terminal.background": "#1a0d2e",
    "terminal.foreground": "#f4e7d3",
    "terminal.ansiBlack": "#2d1b4e",
    "terminal.ansiRed": "#ff4d6d",
    "terminal.ansiGreen": "#39ff14",
    "terminal.ansiYellow": "#ffb347",
    "terminal.ansiBlue": "#6b8cff",
    "terminal.ansiMagenta": "#c77dff",
    "terminal.ansiCyan": "#5ffbf1",
    "terminal.ansiWhite": "#f4e7d3",
    "button.background": "#ff6b35",
    "button.foreground": "#1a0d2e",
    "input.background": "#2d1b4e",
    "input.border": "#3d2a5e",
    "focusBorder": "#ff6b35",
    "list.activeSelectionBackground": "#2d1b4e",
    "list.hoverBackground": "#241340",
    "badge.background": "#ff6b35",
    "badge.foreground": "#1a0d2e"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b8a9d9",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff6b35"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#39ff14"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ff4d6d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6b8cff"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#f4e7d3"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#c77dff"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5ffbf1"
      }
    }
  ]
}
